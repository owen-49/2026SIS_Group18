{
  "manifest_version": 3,
  "name": "ClaimTrace — Citation Audit",
  "version": "0.1.0",
  "description": "Hover over \\cite{...} in Overleaf to verify citation accuracy against source PDFs.",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://www.overleaf.com/*"
  ],

  "action": {
    "default_popup": "src/popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_end"
    }
  ],

  "background": {
    "service_worker": "src/background.js"
  }
}
