# ============================================================
# ClaimTrace — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# .env is git-ignored — never commit real API keys.
# ============================================================

# ── LLM Provider ──────────────────────────────────────────
# Which provider to use for entailment verification.
# Options: openai | deepseek | gemini | anthropic | ollama
CLAIMTRACE_LLM_PROVIDER=deepseek

# ── OpenAI ────────────────────────────────────────────────
# Used when CLAIMTRACE_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Model: gpt-4o (recommended) | gpt-4o-mini (cheaper, faster)
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL for proxies / Azure / compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── DeepSeek ──────────────────────────────────────────────
# Used when CLAIMTRACE_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Model: deepseek-chat (general) | deepseek-reasoner (reasoning)
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Google Gemini ─────────────────────────────────────────
# Used when CLAIMTRACE_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
# Model: gemini-2.0-flash (cheap, fast) | gemini-2.5-pro (stronger)
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude ──────────────────────────────────────
# Used when CLAIMTRACE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model: claude-sonnet-5 (fast, good) | claude-opus-5 (strongest)
ANTHROPIC_MODEL=claude-sonnet-5

# ── Ollama (local, no API key needed) ─────────────────────
# Used when CLAIMTRACE_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Embedding ─────────────────────────────────────────────
# sentence-transformers model for local embeddings.
# all-MiniLM-L6-v2: 384-d, fast, good enough for academic text
# all-mpnet-base-v2: 768-d, better quality, 2× slower
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Server ────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Set to "true" to enable hot reload (off in production)
BACKEND_RELOAD=true

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# ── Upload Limits ─────────────────────────────────────────
# Max upload file size in MB
MAX_UPLOAD_SIZE_MB=50
# Optional local directory for serialised Parser results.
# Defaults to {UPLOAD_DIR}/parsed when omitted.
# PARSED_DIR=uploads/parsed

# ── Parser ───────────────────────────────────────────────
# Yi Jiang's PDF-to-Markdown Parser uses local Java processing by default.
# Set PARSER_HYBRID to docling-fast or hancom-ai when the optional hybrid
# service is running locally.
PARSER_HYBRID=off
# PARSER_HYBRID_MODE=full
# PARSER_HYBRID_URL=http://localhost:5002
# PARSER_USE_STRUCT_TREE=false

# ── Metadata lookup ──────────────────────────────────────
# The bibliography audit resolves each reference against OpenAlex, then
# Crossref. Both are documented REST APIs, each queried once per reference with
# no retry loop and no throttle, and the chain stops at the first provider that
# identifies the work.
# METADATA_LOOKUP_TIMEOUT_SECONDS bounds each socket operation. It is the only
# bound on a lookup: worst case for one reference is two requests at this
# timeout. There is no overall deadline above it, because a blocking socket
# call can be abandoned but not cancelled, and a server that dribbles bytes
# across reads can still outlast it.
METADATA_LOOKUP_TIMEOUT_SECONDS=10
# Crossref and OpenAlex both serve requests carrying a contact address from a
# faster, more reliable pool. The Engine reads this variable directly (there is
# no backend setting for it) and appends it to the User-Agent. Left unset, the
# request is still polite, just from the anonymous pool; set it to an address
# you are willing to send to a third party.
# CLAIMTRACE_CONTACT_MAILTO=
