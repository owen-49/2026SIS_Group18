# Used for Compose interpolation only; not loaded by the application.
# Run commands from claimtrace/ using --env-file backend/deploy/.env.
BACKEND_IMAGE=claimtrace-backend:local
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=50
METADATA_LOOKUP_TIMEOUT_SECONDS=10
REFERENCE_METADATA_TIMEOUT_SECONDS=30
# Relative to backend/deploy/; create this directory before running a backup.
# On Linux it must be writable by container UID 10001.
BACKUP_DIR=./backups
# No paid AI credentials are needed to start or validate this deployment.
